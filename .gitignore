# per-run drafted fuzz_test_file candidates + their review_code.html,
# written by contrib/fuzz/oss-fuzz-gen/fuzz_code_generate_and_draft.py --
# land the reviewed/approved ones via fuzz_code_land_approved.py instead
# of committing this directory itself
