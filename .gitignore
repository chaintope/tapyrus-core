# per-run review page for fuzz_script_generate_pool.py's own candidates
# (the candidates themselves, under generated_pool/tapyrus_script/, ARE
# meant to be committed after review -- only this review page isn't)
contrib/fuzz/fuzz4all/review_scripts_*.html
